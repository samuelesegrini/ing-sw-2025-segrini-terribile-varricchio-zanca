<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0" spacing="10.0" xmlns="http://javafx.com/javafx.21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.client.view.LobbyBrowserController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Label text="Available Games">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>
    <TableView fx:id="joinableGamesTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colJoinableName" prefWidth="200.0" text="Game Name" />
            <TableColumn fx:id="colJoinablePlayers" prefWidth="100.0" text="Players" />
            <TableColumn fx:id="colJoinableLevel" prefWidth="100.0" text="Level" />
            <TableColumn fx:id="colJoinableState" prefWidth="120.0" text="State" />
            <TableColumn fx:id="colJoinableSessionId" prefWidth="150.0" text="Session ID (Debug)" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
    <Label text="Running Games">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>
    <TableView fx:id="runningGamesTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colRunningName" prefWidth="200.0" text="Game Name" />
            <TableColumn fx:id="colRunningPlayers" prefWidth="100.0" text="Players" />
            <TableColumn fx:id="colRunningLevel" prefWidth="100.0" text="Level" />
            <TableColumn fx:id="colRunningState" prefWidth="120.0" text="State" />
            <TableColumn fx:id="colRunningSessionId" prefWidth="150.0" text="Session ID (Debug)" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
    <HBox alignment="CENTER" spacing="10.0">
        <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#handleRefreshButton" text="Refresh List" />
        <Button fx:id="createGameButton" mnemonicParsing="false" onAction="#handleCreateButton" text="Create Game" />
        <Button fx:id="joinButton" mnemonicParsing="false" onAction="#handleJoinButton" text="Join Selected Game" />
    </HBox>
    <Label fx:id="statusLabel" text="Status: Waiting for refresh..." textFill="GRAY">
        <font>
            <Font size="12.0" />
        </font>
    </Label>
</VBox>